# Generated by cmd/gen (2026-09-17T17:45:44Z). Shared teranode settings for the chaos stack.
logLevel=DEBUG
network=regtest
# stores: sqlite + file blobs, no postgres/aerospike
blockchain_store=sqlite:///blockchain
utxostore=sqlite:///utxostore
# admin key shared by all services of a node so peers can become proven sync candidates
grpc_admin_api_key=chaos-24fc8acdbbf10db981e0eed2eb3d7fcc2a6ea096
# asset api rate limits: catch-up fetches 100-block batches from a peer; the default heavy
# limit (10 req/s per IP) returns 429 to a syncing peer on a fast regtest chain
asset_httpRateLimit=100000
asset_httpHeavyRateLimit=10000
# services
startAlert=true
# legacy (Bitcoin wire protocol) service on chaosnet so the SV nodes can follow the chain.
# The SV nodes dial in (-connect); allowSyncCandidateFromLocalPeers lets non-localhost peers
# be sync candidates on regtest; advertiseFullNode (patch 0003) makes the service announce
# NODE_NETWORK from the start - SV Node only syncs from full nodes, and without the block
# persister teranode would announce NODE_NETWORK_LIMITED forever.
startLegacy=true
legacy_listen_addresses=0.0.0.0:18444
legacy_allowSyncCandidateFromLocalPeers=true
legacy_advertiseFullNode=true
startBlockPersister=false
startCoinbase=false
startFaucet=false
minminingtxfee=0
tracing_enabled=false
# intra-node service addresses: the image's docker defaults use ${clientName}:port, which
# resolves to any of the container's three network IPs and breaks internal gRPC when a plane
# is partitioned. Pin everything a node talks to inside itself to localhost.
blockchain_grpcAddress=localhost:8087
blockassembly_grpcAddress=localhost:8085
blockvalidation_grpcAddress=localhost:8088
subtreevalidation_grpcAddress=localhost:8086
validator_grpcAddress=localhost:8081
validator_httpAddress=http://localhost:8834
propagation_grpcAddresses=localhost:8084
propagation_httpAddresses=http://localhost:8833
asset_propagation_proxy_address=http://localhost:8833
p2p_grpcAddress=localhost:9904
pruner_grpcAddress=localhost:8089
legacy_grpcAddress=localhost:8099
legacy_httpAddress=http://localhost:8098
coinbase_grpcAddress=
rpc_address=http://localhost:9292
# main p2p: static mesh over chaosnet only, no DHT. Bootstrap peers are set per node to the
# same mesh, because an empty list makes go-p2p-message-bus fall back to the public IPFS
# bootstrap peers.
p2p_dht_mode=off
p2p_allow_private_ips=true
p2p_share_private_addresses=true
# alert p2p: private network bootstrapped from the go-alert-system hub (patched settings).
# allow_private_ips stays FALSE on purpose: alertnet (192.0.0.128/26) is classified public by
# libp2p, so the alert hosts only advertise/accept alertnet addresses and can never reach each
# other over chaosnet/ctlnet. That is what makes an alert-plane partition airtight.
alert_genesis_keys=02461ae286f650c0c8ed1443878c2c175421c9cd4b55e9c0f90b2f9f632809e9e1 | 024dbb4d7a102e4523d98d3f072d4c5becaa40467d3e0d71c080bcdb1c86e6f20d | 02ac035846df2c3f8d3a8d6f4dc827b22a3b1f09cd9c3f4bc9c4be341bd082a877 | 0251f3950a900533ef793c258d9d9cfade828fca112a3ec443a5d764b3c2304515 | 03752c3c782243daaad416251c4df6bd89689cec6eefba9a568c6346d9f2c6ef4a
alert_p2p_bootstrap_peer=/ip4/192.0.0.130/tcp/9906/p2p/12D3KooWKsvJigHNVRpZCsKYJJfyd1HTBNKob1YWKRKj6CbD93NR
alert_p2p_allow_private_ips=false
alert_p2p_peer_discovery_interval=15s
alert_p2p_dht_mode=client
