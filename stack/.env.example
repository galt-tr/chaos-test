# Copy to .env and adjust. Everything has a working default.
# Teranode image for all nodes (built by `make build-teranode` from TERANODE_REF + the alert patch)
#TERANODE_IMAGE=localhost/teranode-chaos:pr1764
# Per-node override, e.g. run node 2 on the pre-fix upstream main image for comparison:
#TERANODE_IMAGE_2=ghcr.io/bsv-blockchain/teranode:latest
#TERANODE_MEM_LIMIT=3g
#ALERT_SYSTEM_IMAGE=localhost/go-alert-system:v0.1.17
#TOOLS_IMAGE=localhost/chaos-test:local
#HUB_HOST_PORT=3000
# true = no egress from any container network (host ports still work only when false)
INTERNAL=false
