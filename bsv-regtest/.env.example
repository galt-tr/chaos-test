# Copy to .env and adjust; everything has a working default. Compose reads this file.
# Per-node teranode image override, e.g. run node 2 on the published upstream image:
#TERANODE_IMAGE_2=ghcr.io/bsv-blockchain/teranode:latest
#TERANODE_MEM_LIMIT=3g
# Per-node SV Node image override (the default for all nodes is a `make gen SVNODE_IMAGE=` setting)
#SVNODE_IMAGE_1=docker.io/bitcoinsv/bitcoin-sv:1.2.1
#SVNODE_MEM_LIMIT=2g
# Locally built images (make build); change only if you tag them differently
#ALERT_SYSTEM_IMAGE=localhost/bsv-regtest/alert-system:v0.1.17
#TOOLS_IMAGE=localhost/bsv-regtest/tools:local
#WALLETD_IMAGE=localhost/bsv-regtest/walletd:local
#BUSYBOX_IMAGE=docker.io/library/busybox:1.37
# Pulled images
#ARCADE_IMAGE=ghcr.io/bsv-blockchain/arcade:latest
#REDPANDA_IMAGE=docker.io/redpandadata/redpanda:v26.1.9
# Host ports (teranode and SV node ports follow the formulas in the README and are not variables)
#HUB_HOST_PORT=3000
#ARCADE_HOST_PORT=18080
#MERKLE_HOST_PORT=18090
#WALLET_HOST_PORT=18100
#WALLETD_HOST_PORT=18700
# Not compose variables: RUNTIME=podman|docker, INTERNAL=1, N, SV, TERANODE_REF are `make` settings.
